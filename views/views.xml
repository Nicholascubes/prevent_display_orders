<odoo>
  <data>
    <record id="res_config_settings_view_form" model="ir.ui.view">
      <field name="name">res.config.settings.view.form.inherit.pos_restaurant</field>
      <field name="model">res.config.settings</field>
      <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
      <field name="arch" type="xml">
        <xpath expr="//block[@id='pos_interface_section']" position="inside">
          <setting string="Show Empty Orders List by Default" help="Show empty orders list by default and enable search functionality">
            <field name="prevent_display_orders"/>
          </setting>
        </xpath>
      </field>
    </record>
  </data>
</odoo>
