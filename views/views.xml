<odoo>
  <data>
    <record id="res_config_settings_view_form" model="ir.ui.view">
      <field name="name">res.config.settings.view.form.inherit.pos_restaurant</field>
      <field name="model">res.config.settings</field>
      <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
      <field name="arch" type="xml">
        <xpath expr="//block[@id='pos_interface_section']" position="inside">
          <div class="col-xs-12 col-md-6 o_setting_box">
            <div class="o_setting_left_pane">
              <field name="prevent_display_orders"/>
            </div>
            <div class="o_setting_right_pane">
              <label for="prevent_display_orders"/>
              <div class="text-muted">
                               Show empty orders list by default and enable search functionality
              </div>
            </div>
          </div>
        </xpath>
      </field>
    </record>
  </data>
</odoo>
